# Standalone configuration — running this bot outside Home Assistant.
#
# Copy to .env and fill it in. .env is gitignored; never commit real tokens.
# Inside Home Assistant as an add-on none of this is used: the Supervisor
# injects the credential and the options come from the Configuration tab.

# Your Home Assistant API URL, including the /api suffix.
# The Supervisor proxy address only resolves inside Home Assistant, so there is
# no default here.
HA_BASE_URL=http://homeassistant.local:8123/api

# A long-lived access token: Home Assistant -> your profile -> Security ->
# Long-lived access tokens. This is NOT the Telegram token.
HA_TOKEN=

# The token BotFather issued for your bot, shaped like 123456789:AA...
TELEGRAM_BOT_TOKEN=

# Comma-separated chat IDs allowed to use the bot. Group and channel IDs are
# negative. Leave empty to allow every chat — start the bot, send /chatid, then
# come back and fill this in.
ALLOWED_CHAT_IDS=

# Battery percentage at or below which /battery reports a device. 0 to 100.
LOW_BATTERY_THRESHOLD_PERCENT=20
